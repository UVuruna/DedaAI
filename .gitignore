# --- agent tooling and the owner's inbox (never product history) ---
# .claude/ is ignored by CONTENTS (`.claude/*`), not as a whole directory,
# because a bare `.claude/` shadows every pattern below it — a `!` negation
# on a path inside an ignored directory is then silently a no-op (verified
# with `git check-ignore -v`). This is the same fix VibeCoder's and
# Aviator's .gitignore already use for the identical problem.
.claude/*
!.claude/settings.json
UV/
_local/
RENAME.md.done

# --- the VisionClaw fork this app was born from (kept locally until moved to _local/) ---
/VisionClaw/

# --- Android (android/) ---
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/app/src/main/java/**/Secrets.kt
android/keystore/*.jks
android/keystore/*.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# --- wake-word training (wakeword-training/): scripts + configs + report + trained models are tracked, data is not ---
wakeword-training/venv/
wakeword-training/data/
wakeword-training/openWakeWord/
wakeword-training/piper-sample-generator/
wakeword-training/output_*/
wakeword-training/smoke-test/
wakeword-training/__pycache__/
wakeword-training/*.log
wakeword-training/.cache/

# --- release tooling ---
release/*.log
release/guide/*.png
release/guide/shots/
release/*.apk
*.apk

# --- python / misc ---
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
Thumbs.db
